#!/bin/sh
#
# Imposta (o cambia) utente e password del pannello di amministrazione.
# Scrive il file htpasswd che nginx usa per l'accesso a /pannello/ e ricarica
# nginx. Va eseguito come root sul server.
#
#   imposta-password-pannello
#
set -eu

HTPASSWD=/etc/nginx/.htpasswd-autenticatore

if [ "$(id -u)" -ne 0 ]; then
  echo "Va eseguito come root." >&2
  exit 1
fi
if ! command -v openssl >/dev/null 2>&1; then
  echo "Serve openssl (di solito gia' presente): apt-get install -y openssl" >&2
  exit 1
fi

printf "Utente per il pannello [admin]: "
read UTENTE
[ -n "$UTENTE" ] || UTENTE=admin

# La password non si vede mentre la digiti (stty), e la si chiede due volte.
stty -echo 2>/dev/null || true
printf "Password: "; read PW1; printf "\n"
printf "Ripeti password: "; read PW2; printf "\n"
stty echo 2>/dev/null || true

if [ -z "$PW1" ]; then echo "Password vuota, annullato." >&2; exit 1; fi
if [ "$PW1" != "$PW2" ]; then echo "Le due password non coincidono." >&2; exit 1; fi

HASH=$(openssl passwd -apr1 "$PW1")
umask 077
printf "%s:%s\n" "$UTENTE" "$HASH" > "$HTPASSWD"
chmod 640 "$HTPASSWD"
chown root:www-data "$HTPASSWD" 2>/dev/null || true

if nginx -t >/dev/null 2>&1; then
  systemctl reload nginx
  echo "Fatto. Accedi al pannello con l'utente \"$UTENTE\"."
else
  echo "ATTENZIONE: nginx -t segnala un problema, ricarica non eseguita." >&2
  exit 1
fi
