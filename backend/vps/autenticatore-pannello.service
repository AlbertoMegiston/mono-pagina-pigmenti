[Unit]
Description=Autenticatore CLG - pannello di amministrazione
After=network.target

[Service]
Type=simple
User=autenticatore
Group=autenticatore
ExecStart=/usr/bin/python3 /opt/autenticatore/admin_server.py
Environment=CLG_DB=/var/lib/autenticatore/clg.db
Environment=CLG_PANEL_HOST=127.0.0.1
Environment=CLG_PANEL_PORT=8788
Restart=on-failure
RestartSec=2

# Stesse restrizioni del servizio di verifica: tocca solo il proprio database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autenticatore
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
