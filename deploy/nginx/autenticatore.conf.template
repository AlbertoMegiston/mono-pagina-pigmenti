# Autenticatore CLG — sito statico e API di verifica sulla stessa origine.
# __DOMAIN__ viene sostituito da setup.sh. Il blocco HTTPS lo aggiunge certbot.

# Limite di richieste sull'API: un codice valido si verifica una volta ogni
# tanto, non venti volte al minuto. Frena chi provasse a tentare codici a caso.
# Chiave del limite: per IPv4 l'indirizzo intero; per IPv6 il /64 (i primi
# quattro gruppi). Un singolo assegnatario IPv6 dispone di un intero /64 e
# potrebbe altrimenti aggirare il limite cambiando indirizzo a ogni richiesta;
# le forme compresse (con "::") non catturate ricadono sull'indirizzo pieno.
map $remote_addr $clg_limit_key {
    default                                                    $remote_addr;
    "~^(?<blocco64>[0-9a-f]+:[0-9a-f]+:[0-9a-f]+:[0-9a-f]+):"  $blocco64;
}
limit_req_zone $clg_limit_key zone=clgapi:10m rate=20r/m;
# Invio del codice via email: ogni richiesta costa un'email, quindi il limite
# e' piu' stretto (il servizio applica poi i suoi, per indirizzo e per IP).
limit_req_zone $clg_limit_key zone=clgotp:1m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/autenticatore;
    index index.html;

    # La pagina e' un unico file con tutto dentro: nessuna cache lunga, cosi'
    # una nuova versione si vede subito.
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), geolocation=(), microphone=()" always;
    # La fotocamera serve allo scan del QR: resta concessa alla pagina stessa.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    # text/html e' gia' compresso da nginx: ripeterlo qui e' solo un warning.
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 16k;

    location = /api/verify {
        limit_req zone=clgapi burst=10 nodelay;
        proxy_pass http://127.0.0.1:8787/api/verify;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # otp-inizio: setup.sh usa questi due marcatori per aggiungere il blocco
    # a una configurazione gia' passata da certbot (che non rigenera).
    location = /api/otp/invia {
        limit_req zone=clgotp burst=3 nodelay;
        proxy_pass http://127.0.0.1:8787/api/otp/invia;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Il servizio aspetta Mailgun fino a 8 secondi.
        proxy_read_timeout 15s;
    }

    location = /api/otp/verifica {
        limit_req zone=clgapi burst=10 nodelay;
        proxy_pass http://127.0.0.1:8787/api/otp/verifica;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }
    # otp-fine

    # Sonda di stato, utile solo da dentro la macchina.
    location = /api/health {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8787/api/health;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
